# 广西六堡茶大宗交易市场价格发布系统

## 环境变量配置

# Server
NODE_ENV=development
PORT=3000

# Database
# SQLite (开发环境)
DB_TYPE=sqlite

# MySQL (生产环境)
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=liupao_price
# DB_USER=root
# DB_PASS=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=24h

# CORS
CORS_ORIGIN=http://localhost:3000

# Log
LOG_LEVEL=info
